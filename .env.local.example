# Copy this file to .env.local and fill in values from your Supabase project
# (Project Settings -> API in the Supabase dashboard).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: only needed for server-side scripts that bypass RLS (e.g. seeding).
# Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Card data comes from TCGdex (api.tcgdex.net) — free, open source, no API
# key needed. No env var required here.
